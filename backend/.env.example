ALLOWED_ORIGINS=http://localhost:5173
# En producción: origen HTTPS exacto de Vercel, más localhost si se mantiene desarrollo.
# PORT lo proporciona Render; ejecutar sh start.sh (un worker).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=35
GEMINI_CONTEXT_CHARS=45000
GEMINI_MAX_OUTPUT_TOKENS=7000
# Alternativa experimental; requiere habilitación explícita y selección por conversación.
OPENAI_TERRA_ENABLED=false
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=12000
# Límites locales por proveedor/proceso; incluyen correcciones y reintentos existentes de Gemini.
AI_REQUESTS_PER_MINUTE=20
AI_MAX_REQUESTS_PER_TURN=4
MAX_FILE_BYTES=10485760
MAX_ROWS=20000
MAX_COLUMNS=120
MAX_EXPANDED_BYTES=31457280
MAX_CONVERSATION_FILES=12
MISSING_VALUE_MARKERS=NA,N/A,null,NaN,None,<NA>
# JSON opcional por columna, después de confirmar el significado de los marcadores.
MISSING_VALUE_OVERRIDES={}
